#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# recpt1 as a TS server (OpenIRD add-on).
#
# "recpt1 --http <port>" makes the tuner an HTTP server: a client asks for
#     GET /<channel>[/<sid>]
# and gets the TS as it is received, until it closes the connection.  One
# client at a time (one tuner).  recpt1 is built without libarib25: the
# stream is passed on as it was broadcast.
#
# Settings go to /etc/default/recpt1.  That file is not part of the add-on,
# so it stays when the add-on is replaced:
#     PORT=12345
#     DEVICE=/dev/irdvideo0
# What recpt1 says goes to the system log (/var/log/messages, tag "recpt1").
# Messages are ASCII only.

DAEMON=/usr/bin/recpt1
PORT=12345
DEVICE=/dev/irdvideo0
[ -r /etc/default/recpt1 ] && . /etc/default/recpt1

# recpt1 turns itself into a daemon and writes no pid file: find it by its
# command line.  A recording started by hand is another recpt1, and none of
# this script's business.
daemon_pid() {
	local p
	for p in $(pidof recpt1); do
		case "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)" in
			"$DAEMON --http "*) echo "$p"; return 0 ;;
		esac
	done
	return 1
}

start() {
	printf "Starting recpt1 (http, port %s): " "$PORT"
	daemon_pid >/dev/null && { echo "already running"; return 0; }
	# Nothing of the caller's stays open in the daemon (an ssh session
	# would wait for it to be closed).
	"$DAEMON" --http "$PORT" --device "$DEVICE" 2>&1 </dev/null |
		logger -t recpt1 >/dev/null 2>&1 &
	# recpt1 takes the port after it has forked, and leaves if it cannot
	# have it: a daemon that is still there a moment later is listening.
	sleep 1
	daemon_pid >/dev/null || { echo "FAIL"; return 1; }
	echo "OK"
}

stop() {
	local pid
	printf "Stopping recpt1: "
	pid="$(daemon_pid)" || { echo "not running"; return 0; }
	# TERM ends the stream that is being sent and gives the tuner back.
	# The daemon itself can outlive it: once recpt1 has served a client it
	# keeps TERM blocked while it waits for the next one.  So KILL follows.
	kill "$pid" 2>/dev/null
	sleep 1
	kill -KILL "$pid" 2>/dev/null
	# a start may follow at once: it must not meet the one that is going
	while kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
	done
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
