#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# recpt1 as a TS server (OpenIRD add-on).
#
# "recpt1 --http <port>" makes the tuner an HTTP server: a client asks for
#     GET /<channel>[/<sid>]
# and gets the TS as it is received, until it closes the connection.  One
# client at a time (one tuner).
#
# recpt1 is built with libarib25.  By default it passes the stream on as it
# was broadcast; set B25=1 (below) to descramble with a B-CAS card in the
# reader.  Use that only with your own legitimately issued card, for
# broadcasts you are licensed to receive.
#
# The server ends by itself on some errors (it cannot accept, the tuner does
# not start recording).  A watchdog - this script, run as "S80recpt1 watch" -
# starts it, and starts it again a few seconds after it has ended.  stop ends
# both.
#
# Settings go to /etc/default/recpt1.  That file is not part of the add-on,
# so it stays when the add-on is replaced:
#     PORT=12345
#     DEVICE=/dev/irdvideo0
#     B25=0            # 1 to descramble with a B-CAS card (needs a reader)
# What recpt1 says goes to the system log (/var/log/messages, tag "recpt1"),
# and so does every restart.  Messages are ASCII only.

SELF=/etc/init.d/S80recpt1
DAEMON=/usr/bin/recpt1
PIDFILE=/var/run/recpt1-watchdog.pid
PORT=12345
DEVICE=/dev/irdvideo0
B25=0
[ -r /etc/default/recpt1 ] && . /etc/default/recpt1

# extra daemon arguments from the settings (only --b25 for now)
B25ARG=
[ "$B25" = 1 ] && B25ARG=--b25

# recpt1 turns itself into a daemon and writes no pid file: find it by its
# command line.  A recording started by hand is another recpt1 (no --http),
# and none of this script's business.
daemon_pid() {
	local p
	for p in $(pidof recpt1); do
		case "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)" in
			"$DAEMON "*"--http "*) echo "$p"; return 0 ;;
		esac
	done
	return 1
}

watchdog() {
	start-stop-daemon -q -p "$PIDFILE" -x /bin/sh "$@"
}

# halt: end the server.  TERM ends the stream that is being sent and gives
# the tuner back.  The daemon itself can outlive it: once recpt1 has served a
# client it keeps TERM blocked while it waits for the next one.  So KILL
# follows.
halt() {
	local pid
	pid="$(daemon_pid)" || return 0
	kill "$pid" 2>/dev/null
	sleep 1
	kill -KILL "$pid" 2>/dev/null
	# a start may follow at once: it must not meet the one that is going
	while kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
	done
}

watch() {
	# stop sends TERM: it takes effect once the server has gone (the pipe
	# below has ended), so no new one is started after that
	trap 'exit 0' TERM
	set -- $B25ARG --http "$PORT" --device "$DEVICE"
	while :; do
		# The daemon keeps the write end of the pipe, so logger reads
		# until the server ends.  "$@" is the daemon's command line.
		"$DAEMON" "$@" 2>&1 </dev/null |
			logger -t recpt1
		logger -t recpt1 "the server has ended; starting it again in 5 seconds"
		sleep 5 &
		wait $!
	done
}

start() {
	printf "Starting recpt1 (http, port %s): " "$PORT"
	watchdog -K -t && { echo "already running"; return 0; }
	# a server left without its watchdog would keep the port
	halt
	watchdog -S -b -m -- "$SELF" watch
	# recpt1 takes the port after it has forked, and leaves if it cannot
	# have it: a daemon that is still there a moment later is listening.
	sleep 1
	daemon_pid >/dev/null || {
		echo "FAIL (trying again every 5 seconds, see /var/log/messages)"
		return 1
	}
	echo "OK"
}

stop() {
	printf "Stopping recpt1: "
	# the watchdog first, so that it starts no new server
	watchdog -K
	halt
	# A server may have been starting as the watchdog got TERM: end that
	# one too, until the watchdog is gone.
	while watchdog -K -t; do
		halt
		sleep 0.1
	done
	rm -f "$PIDFILE"
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; start ;;
	watch) watch ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
